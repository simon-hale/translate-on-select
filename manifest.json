{
  "name": "Translate-on-select",
  "description": "Translate selected text on any webpage right where you are reading it.",
  "version": "2.0.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "menu/menu.html",
    "default_icon": "icons/icon_128.png"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared/i18n.js", "shared/theme.js", "front/contentScript.js"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon_16.png",
    "32": "icons/icon_32.png",
    "48": "icons/icon_48.png",
    "128": "icons/icon_128.png"
  }
}
